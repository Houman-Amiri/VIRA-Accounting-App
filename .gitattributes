# Consistent line endings
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary
*.xlsx binary
*.png binary
*.jpg binary
*.pdf binary
*.ttf binary
*.woff2 binary

